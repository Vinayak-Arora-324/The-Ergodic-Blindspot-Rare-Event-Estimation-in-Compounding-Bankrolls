   3.993541144545789*^9, 3.993541177919942*^9, {3.9935415842959948`*^9, 
   3.993541593690365*^9}, {3.993541674964591*^9, 3.9935416770930758`*^9}, {
   3.993541782226199*^9, 3.993541789017385*^9}, {3.993542204504251*^9, 
