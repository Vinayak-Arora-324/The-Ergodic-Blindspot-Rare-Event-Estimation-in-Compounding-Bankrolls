(* Beginning of Notebook Content *)
Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Checking", " ", "whether", " ", "mcs", " ", "are", " ", "needed", " ", 
    "at", " ", "all", " ", "or", " ", "not"}], "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{"(*", "Parameters", "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"lam", "=", 
     RowBox[{"10", "^", 
      RowBox[{"-", "3"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"beta", "=", "1.5"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"s", "=", "0.05"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"targetMu", "=", "0.005"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"m", "=", 
     RowBox[{"targetMu", "+", 
      RowBox[{"lam", "*", "beta"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Robustly", " ", "compiled", " ", "sampling", " ", "function", " ", 
     "using", " ", "WVM"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"drawCompiled", "=", 
     RowBox[{"Compile", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"n", ",", "_Integer"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"rate", ",", "_Real"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "_Real"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "_Real"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"beta", ",", "_Real"}], "}"}]}], "}"}], ",", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "norm", ",", "uniform", ",", "expon", ",", "i", ",", "res"}], "}"}],
          ",", 
         RowBox[{
          RowBox[{"res", "=", 
           RowBox[{"Table", "[", 
            RowBox[{"0.0", ",", 
             RowBox[{"{", "n", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Do", "[", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"Manual", " ", "Box"}], "-", 
             RowBox[{
             "Muller", " ", "transform", " ", "for", " ", "safe", " ", 
              "compilation", " ", "of", " ", "Normal", " ", 
              "distribution"}]}], "*)"}], 
           RowBox[{
            RowBox[{
             RowBox[{"norm", "=", 
              RowBox[{"m", "+", 
               RowBox[{"s", "*", 
                RowBox[{"Sqrt", "[", 
                 RowBox[{
                  RowBox[{"-", "2.0"}], "*", 
                  RowBox[{"Log", "[", 
                   RowBox[{"RandomReal", "[", 
                    RowBox[{"{", 
                    RowBox[{"0.0001", ",", "1"}], "}"}], "]"}], "]"}]}], 
                 "]"}], "*", 
                RowBox[{"Cos", "[", 
                 RowBox[{"2.0", "*", "Pi", "*", 
                  RowBox[{"RandomReal", "[", "]"}]}], "]"}]}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"expon", "=", 
              RowBox[{
               RowBox[{"-", "beta"}], "*", 
               RowBox[{"Log", "[", 
                RowBox[{"RandomReal", "[", 
                 RowBox[{"{", 
                  RowBox[{"0.0001", ",", "1"}], "}"}], "]"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"res", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "=", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"RandomReal", "[", "]"}], "<", "rate"}], ",", 
                RowBox[{"norm", "-", "expon"}], ",", "norm"}], "]"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", "res"}]}], "]"}], ",", 
       RowBox[{"CompilationTarget", "->", "\"\<WVM\>\""}], ",", 
       RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Mixture", " ", "PDF", " ", "definitions"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "r_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "lam"}], ")"}], "*", 
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"m", ",", "s"}], "]"}], ",", "r"}], "]"}]}], "+", 
      RowBox[{"lam", "*", 
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"ExponentiallyModifiedGaussianDistribution", "[", 
          RowBox[{
           RowBox[{"-", "m"}], ",", "s", ",", 
           RowBox[{"1", "/", "beta"}]}], "]"}], ",", 
         RowBox[{"-", "r"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"S0", "=", "100.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"K", "=", "50.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"c", "=", "0.0005"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"payoff", "[", "r_", "]"}], ":=", 
     RowBox[{"Ramp", "[", 
      RowBox[{"K", "-", 
       RowBox[{"S0", "*", 
        RowBox[{"Exp", "[", "r", "]"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Adjusted", " ", "LO", " ", "to"}], "-", 
     RowBox[{"5.0", " ", "to", " ", "eliminate", " ", "numerical", " ", 
      RowBox[{"underflow", "/", "indeterminate"}], " ", "tail", " ", 
      "errors"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LO", "=", 
     RowBox[{"-", "5.0"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"HI", "=", "2.0"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Numerical", " ", "Integration", " ", "for", " ", "base", " ", "price"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"price", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"payoff", "[", "r", "]"}], "*", 
        RowBox[{"f", "[", "r", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "LO", ",", "HI"}], "}"}], ",", 
       RowBox[{"Method", "->", "\"\<GlobalAdaptive\>\""}], ",", 
       RowBox[{"MaxRecursion", "->", "15"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"lg", "[", "r_", "]"}], ":=", 
     RowBox[{"Log", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "c"}], ")"}], "*", 
        RowBox[{"Exp", "[", "r", "]"}]}], "+", 
       RowBox[{"c", "*", 
        RowBox[{
         RowBox[{"payoff", "[", "r", "]"}], "/", "price"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"d", "[", "r_", "]"}], ":=", 
     RowBox[{
      RowBox[{"lg", "[", "r", "]"}], "-", "r"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"gH", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"lg", "[", "r", "]"}], "*", 
        RowBox[{"f", "[", "r", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "LO", ",", "HI"}], "}"}], ",", 
       RowBox[{"Method", "->", "\"\<GlobalAdaptive\>\""}], ",", 
       RowBox[{"MaxRecursion", "->", "15"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"edge", "=", 
     RowBox[{"gH", "-", "targetMu"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Variance", " ", "analysis"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "11", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{"drawCompiled", "[", 
      RowBox[{"2000000", ",", "lam", ",", "m", ",", "s", ",", "beta"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"sdLg", "=", 
     RowBox[{"StandardDeviation", "[", 
      RowBox[{"lg", "[", "x", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sdD", "=", 
     RowBox[{"StandardDeviation", "[", 
      RowBox[{"d", "[", "x", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"TemplateApply", "[", 
      RowBox[{"\"\<sd of log_growth (crude target) : ``   <- bulk noise, s=``\
\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"NumberForm", "[", 
          RowBox[{"sdLg", ",", 
           RowBox[{"{", 
            RowBox[{"Inf", ",", "4"}], "}"}]}], "]"}], ",", "s"}], "}"}]}], 
      "]"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"TemplateApply", "[", 
      RowBox[{"\"\<sd of D          (after CV)     : ``   <- rare-event \
only\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"sdD", ",", 
          RowBox[{"{", 
           RowBox[{"Inf", ",", "4"}], "}"}]}], "]"}], "}"}]}], "]"}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"TemplateApply", "[", 
      RowBox[{"\"\<edge to resolve                 : ``\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"edge", ",", 
          RowBox[{"{", 
           RowBox[{"Inf", ",", "6"}], "}"}], ",", 
          RowBox[{"NumberSigns", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<-\>\"", ",", "\"\<+\>\""}], "}"}]}]}], "]"}], 
        "}"}]}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"nCrude", "=", 
     RowBox[{"Floor", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "*", 
         RowBox[{"sdLg", "/", "edge"}]}], ")"}], "^", "2"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nCV", "=", 
     RowBox[{"Floor", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "*", 
         RowBox[{"sdD", "/", "edge"}]}], ")"}], "^", "2"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nN needed for crude MC to resolve sign at 2 sigma : \>\"",
       ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"nCrude", ",", 
        RowBox[{"DigitBlock", "->", "3"}], ",", 
        RowBox[{"NumberSeparator", "->", "\"\<,\>\""}]}], "]"}]}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<N needed after control variate                   : \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"nCV", ",", 
        RowBox[{"DigitBlock", "->", "3"}], ",", 
        RowBox[{"NumberSeparator", "->", "\"\<,\>\""}]}], "]"}]}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"CV", "+", 
     RowBox[{"IS", " ", "Setup"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lamQ", "=", "0.30"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"q", "[", "r_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "lamQ"}], ")"}], "*", 
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"m", ",", "s"}], "]"}], ",", "r"}], "]"}]}], "+", 
      RowBox[{"lamQ", "*", 
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"ExponentiallyModifiedGaussianDistribution", "[", 
          RowBox[{
           RowBox[{"-", "m"}], ",", "s", ",", 
           RowBox[{"1", "/", "beta"}]}], "]"}], ",", 
         RowBox[{"-", "r"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"nSample", "=", "5000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"trials", "=", "1500"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Vectorized", " ", "simulation", " ", "tracks"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cvVal", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mean", "[", 
         RowBox[{"d", "[", 
          RowBox[{"drawCompiled", "[", 
           RowBox[{"nSample", ",", "lam", ",", "m", ",", "s", ",", "beta"}], 
           "]"}], "]"}], "]"}], "+", "targetMu"}], ",", 
       RowBox[{"{", "trials", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cvIsVal", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "y", "}"}], ",", 
         RowBox[{
          RowBox[{"y", "=", 
           RowBox[{"drawCompiled", "[", 
            RowBox[{"nSample", ",", "lamQ", ",", "m", ",", "s", ",", "beta"}],
             "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Mean", "[", 
            RowBox[{
             RowBox[{"d", "[", "y", "]"}], "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"f", "[", "y", "]"}], "/", 
               RowBox[{"q", "[", "y", "]"}]}], ")"}]}], "]"}], "+", 
           "targetMu"}]}]}], "]"}], ",", 
       RowBox[{"{", "trials", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"crudeVal", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Mean", "[", 
        RowBox[{"lg", "[", 
         RowBox[{"drawCompiled", "[", 
          RowBox[{"nSample", ",", "lam", ",", "m", ",", "s", ",", "beta"}], 
          "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", "trials", "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Formatted", " ", "tabular", " ", "printout"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\n\>\"", ",", 
      RowBox[{"StringPadRight", "[", 
       RowBox[{"\"\<estimator\>\"", ",", "28"}], "]"}], ",", "\"\< \>\"", ",", 
      RowBox[{"StringPadLeft", "[", 
       RowBox[{"\"\<sd\>\"", ",", "10"}], "]"}], 
      ",", "\"\<  var-reduction vs crude\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sdCrude", "=", 
     RowBox[{"StandardDeviation", "[", "crudeVal", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"nm", "=", 
           RowBox[{"item", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"e", "=", 
           RowBox[{"item", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", "sdE", ",", "varRed"}], 
         "}"}], ",", 
        RowBox[{
         RowBox[{"sdE", "=", 
          RowBox[{"StandardDeviation", "[", "e", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"varRed", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"sdCrude", "/", "sdE"}], ")"}], "^", "2"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
           RowBox[{"StringPadRight", "[", 
            RowBox[{"nm", ",", "28"}], "]"}], ",", "\"\< \>\"", ",", 
           RowBox[{"StringPadLeft", "[", 
            RowBox[{
             RowBox[{"ToString", "[", 
              RowBox[{"NumberForm", "[", 
               RowBox[{"sdE", ",", 
                RowBox[{"{", 
                 RowBox[{"Inf", ",", "6"}], "}"}]}], "]"}], "]"}], ",", 
             "10"}], "]"}], ",", "\"\<  \>\"", ",", 
           RowBox[{"NumberForm", "[", 
            RowBox[{"varRed", ",", 
             RowBox[{"{", 
              RowBox[{"Inf", ",", "1"}], "}"}]}], "]"}], ",", "\"\<x\>\""}], 
          "]"}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"item", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<crude MC\>\"", ",", "crudeVal"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<+ control variate\>\"", ",", "cvVal"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<+ CV + importance sampling\>\"", ",", "cvIsVal"}], 
           "}"}]}], "}"}]}], "}"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"The", " ", "decisive", " ", "point"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"timing", "=", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"lg", "[", "r", "]"}], "*", 
          RowBox[{"f", "[", "r", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "LO", ",", "HI"}], "}"}], ",", 
         RowBox[{"Method", "->", "\"\<GlobalAdaptive\>\""}], ",", 
         RowBox[{"MaxRecursion", "->", "15"}]}], "]"}], ";"}], "]"}]}], ";"}],
    "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"TemplateApply", "[", 
     RowBox[{"\"\<\\nquadrature gives the EXACT answer in `` ms. No Monte \
Carlo needed at all.\>\"", ",", 
      RowBox[{"{", 
       RowBox[{"NumberForm", "[", 
        RowBox[{
         RowBox[{"1000", "*", 
          RowBox[{"timing", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"Inf", ",", "1"}], "}"}]}], "]"}], "}"}]}], "]"}], 
    "]"}]}]}]], "Input",
